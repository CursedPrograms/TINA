<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for TINA, the fleet's engineer, sampled from her avatar
  (images/tina_avatar.jpg): the deep navy behind her, her golden hair, her
  cyan-blue skin and the teal-green sparkles around her.
  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <colour name="background"       value="#0D141C"/>  <!-- window / page background -->
  <colour name="panel"            value="#15202B"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#26384A"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#1B2835"/>  <!-- lines between rows -->
  <colour name="text"             value="#E8EEF2"/>  <!-- primary text -->
  <colour name="text_sec"         value="#9FB0BD"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#5E6F7C"/>  <!-- labels, section titles -->
  <colour name="accent"           value="#E3D43A"/>  <!-- her golden hair: logo, links, selected -->
  <colour name="accent_hover"     value="#F0E57A"/>  <!-- lighter accent -->
  <colour name="accent2"          value="#2AA7C6"/>  <!-- her cyan-blue skin: tool calls, highlights -->
  <colour name="accent3"          value="#36B8AF"/>  <!-- the teal sparkles -->
  <colour name="ok"               value="#56C59D"/>  <!-- checks passed -->
  <colour name="warn"             value="#F2A33A"/>  <!-- waiting on you -->
  <colour name="problem"          value="#FF6B4A"/>  <!-- failed -->
  <colour name="button_hover_bg"  value="#1A2A33"/>  <!-- button fill when hovered / selected -->
  <colour name="danger_bg"        value="#210F0D"/>  <!-- danger button fill -->
</colour_scheme>
